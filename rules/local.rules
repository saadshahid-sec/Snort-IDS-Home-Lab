# This file contains custom Snort detection rules developed and tested as part of my home lab project.

# Snort also supports pre-built detection rules developed by the Snort community.

For this project, the default rule includes were disabled in snort.conf to focus on understanding Snort rule systax and developing custom detection rules.

alert icmp any any -> $HOME_NET any (msg: "ICMP Echo Request Detected"; itype:8; sid:1000001; rev:1;)
alert icmp $HOME_NET any -> any any (msg: "ICMP Echo Reply Detected"; itype:0; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg: "SSH Connection Attempt Detected"; flags:S; sid:1000003; rev:1;)
alert tcp $HOME_NET 22 -> any any (msg: "SSH SYN-ACK Detected"; flags:SA; sid:1000004; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg: "SSH ACK Detected"; flags:A; sid:1000005; rev:1;)
alert tcp any any -> 192.168.26.10 21 (msg: "FTP Connection Attempt Detected"; sid:1000006; rev:1;)



